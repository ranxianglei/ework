# Example .env for ework-mirror.
# Real .env is generated by `./scripts/install.sh` at first install.

PORT=1197
HOST=127.0.0.1

EWORK_WEBHOOK_SECRET=replace-with-random-hex

GITEA_URL=http://gitea.local:3000
GITEA_TOKEN=replace-with-awork-user-gitea-token

GITEA_ACT_AS=awork

DB_PATH=
VERBOSE=false
