# ---- ework-web (Gitea-compatible REST shim) ----
# Point the daemon at the ework-web sidecar instead of real Gitea.
GITEA_URL=http://localhost:3002
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=

# ---- Bot identity ----
# BOT_USERNAME must match the user that BOT_TOKEN posts as (anti-recursion
# checks comment.author === BOT_USERNAME). Issue this user's PAT via
# ework-web's /me/tokens page or POST /admin/tokens.
BOT_USERNAME=ework-daemon
BOT_TOKEN=

# ---- Daemon ----
DAEMON_PORT=3101
DAEMON_HOST=0.0.0.0

# ---- OpenCode ----
OPENCODE_BINARY=opencode
OPENCODE_BASE_WORKDIR=/home/<user>/projects

# ---- Master env switch ----
# Must be `production` for the daemon to use this .env's values; otherwise
# it falls through to .env.test + safe test defaults.
DAEMON_ENV=production

# ---- Completion Check (optional) ----
# If configured, uses a model API to judge task completion instead of
# spawning another opencode process. Uses OpenAI-compatible API format.
# COMPLETION_CHECK_API_KEY=
# COMPLETION_CHECK_BASE_URL=
# COMPLETION_CHECK_MODEL=

# ---- Stuck-process detection (optional) ----
# DAEMON_STUCK_THRESHOLD_MS=1800000   # 30 min default
# DAEMON_MAX_STUCK_NUDGES=1
