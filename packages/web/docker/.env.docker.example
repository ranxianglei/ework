# ework all-in-one Docker env. Copy to .env.docker and pass to docker run.
# All vars here are REQUIRED unless noted.

# ─── ework ─────────────────────────────────────────────────────────────────
# Access token for ework UI/API (acts as Gitea-compat Bearer token too).
WORK_TOKEN=change-me-please-make-it-long
# HMAC secret for auth cookie (any long random string).
WORK_COOKIE_SECRET=change-me-too-also-long
# Bootstrap admin login (created on first boot, no password).
WORK_OPERATOR_LOGIN=op

# ─── ework-daemon ──────────────────────────────────────────────────────────
# Shared secret used to sign webhooks from ework to daemon.
GITEA_WEBHOOK_SECRET=another-random-string

# Bot user the daemon authenticates as (created + PAT minted on first boot).
BOT_USERNAME=ework-daemon
# BOT_TOKEN is auto-generated by entrypoint.sh; don't set it manually.

# ─── opencode ──────────────────────────────────────────────────────────────
# Where opencode clones repos / runs agents. Mount this as a volume.
OPENCODE_BASE_WORKDIR=/data/opencode-workdir

# opencode reads its own config from $HOME/.config/opencode/ or env vars like:
#   OPENCODE_AI_API_KEY, OPENCODE_AI_MODEL, OPENCODE_AI_BASE_URL
# Mount your opencode config dir as a volume:
#   -v ~/.config/opencode:/root/.config/opencode:ro

# ─── Optional overrides ────────────────────────────────────────────────────
# ework listens on :3002, daemon on :3101 (hardcoded in supervisord.conf).
# To talk to a real Gitea for git operations (instead of ework's Gitea-compat
# API), set GITEA_URL to that Gitea and GITEA_TOKEN to a real Gitea token:
# GITEA_URL=http://gitea.example.com:3000
# GITEA_TOKEN=<real-gitea-token>
