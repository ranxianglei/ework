# ework environment config. Copy to `.env` and fill in.
# Zod-validated in src/config.ts; missing required values = hard fail at boot.

# Server
# Default port 3002. Override if your environment requires a specific port
# (e.g. VPN routing, reverse proxy, container mapping).
WORK_PORT=3002
# Bind '::' for IPv6 dual-stack (IPv4 + IPv6 via v4-mapped; works for LAN/remote IPv6 access).
# Use '127.0.0.1' for IPv4 loopback only (no LAN/IPv6).
WORK_HOST=::

# Auth — token required to access ework (external-facing). Set a strong random string.
# During dev you may also pass it as ?token=... on first hit; it then gets stored in a signed cookie.
WORK_TOKEN=change-me

# Secret used to sign the auth cookie (any long random string).
WORK_COOKIE_SECRET=change-me-too

# The login name attributed to all writes (single-operator mode).
# Schema reserves multi-user; auth stays single-token for now.
WORK_OPERATOR_LOGIN=op

# Allow write operations (create issue / post comment / close-reopen / upload / reactions).
# ework is for humans to use, so default true.
WORK_WRITES_ENABLED=true

# Override DB path (defaults to $XDG_DATA_HOME/ework/ework.db).
#WORK_DB_PATH=

# Override attachment storage root (defaults to $XDG_DATA_HOME/ework/attachments).
#WORK_ATTACHMENT_ROOT=

# Translate endpoint (OpenAI-compatible /v1/chat/completions). Empty = translation disabled.
# Example: WORK_TRANSLATE_URL=http://localhost:8199/v1
WORK_TRANSLATE_URL=

# Translate model name (passed as "model" in chat completion request).
WORK_TRANSLATE_MODEL=qwen2.5-7b

# TTS backends (OpenAI-compatible /v1/audio/speech). JSON array; empty = TTS disabled.
# Example: WORK_TTS_BACKENDS=[{"id":"kokoro","label":"Kokoro","url":"http://localhost:9880/v1","voice":"zf_001"}]
WORK_TTS_BACKENDS=[]

# File-viewer whitelist. Comma-separated absolute paths. Reads outside these roots = 403.
WORK_FILE_ROOTS=/tmp

# Auth hooks (optional). Path to a JS module that exports an AuthProvider.
# Internal hook: daemon / machine-to-machine (permanent credentials).
# User hook: human users (can expire — SSO/OAuth/LDAP).
# Both share the same interface; see examples/ for templates.
#WORK_INTERNAL_AUTH_HOOK=/etc/ework/hooks/internal-auth.js
#WORK_USER_AUTH_HOOK=/etc/ework/hooks/user-auth.js

# Custom login page HTML (optional). If set, replaces the built-in login page.
# The file must contain a form POSTing to /login with fields: token, login, password, next.
# Template variables: {{next}} and {{error}} are substituted.
#WORK_LOGIN_PAGE=/etc/ework/login.html
