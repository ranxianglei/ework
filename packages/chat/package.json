{
  "name": "ework-chat",
  "version": "0.1.0",
  "description": "Standalone chat component: chat-only LLM with transparent compression (bili) and per-turn disk persistence (agent-style JSONL sessions)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "ework-chat": "./bin/ework-chat.js"
  }
}
