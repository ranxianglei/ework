# ework all-in-one container configuration.
# Copy to .env.docker and edit before `docker compose up`.

# ── Required ───────────────────────────────────────────────────────────────
# Auth for the web UI operator account. Generate secrets with:
#   openssl rand -hex 16
WORK_TOKEN=change-me-at-least-8-chars
WORK_COOKIE_SECRET=change-me-at-least-8-chars
# Signs webhooks between ework-web and ework-daemon (internal).
GITEA_WEBHOOK_SECRET=change-me-at-least-8-chars

# ── Model endpoint (strongly recommended) ──────────────────────────────────
# Any OpenAI-compatible /v1 endpoint. To use a server on the Docker host:
#   WORK_LLM_BASE_URL=http://host.docker.internal:8199/v1
# (Docker Desktop on Windows/macOS resolves host.docker.internal natively;
# the bundled compose file adds the mapping for Linux.)
# Example for a hosted API:
#   WORK_LLM_BASE_URL=https://api.deepseek.com/v1
#   WORK_LLM_MODEL=deepseek-chat
#   WORK_LLM_API_KEY=sk-...
#WORK_LLM_BASE_URL=
#WORK_LLM_MODEL=main
#WORK_LLM_API_KEY=dummy
#WORK_LLM_PROVIDER=ework

# ── Optional ───────────────────────────────────────────────────────────────
# Operator login name created at first boot (password = WORK_TOKEN).
#WORK_OPERATOR_LOGIN=op
# Bot account the daemon acts as.
#BOT_USERNAME=ework-daemon
